# Copia este archivo a .env y rellena lo que uses.
# En Netlify, estas mismas variables van en Site configuration › Environment variables.

# ---------- Front (Vite: solo las VITE_* llegan al navegador) ----------
# true = la app funciona sin backend ni claves (datos simulados alrededor de tu ubicación)
VITE_USE_MOCKS=true

# ---------- Backend (Netlify Functions: nunca llegan al navegador) ----------
# ElevenLabs: voz → texto (Scribe) y texto → voz (lectura de los puntos de interés)
ELEVENLABS_API_KEY=
# Voz para leer los detalles. Búscala en elevenlabs.io › Voices y copia su ID.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# LLM (Anthropic). Un modelo rápido para la intención y otro más capaz para la ruta.
ANTHROPIC_API_KEY=
INTENT_MODEL=claude-haiku-5-5
ROUTE_MODEL=claude-sonnet-5-5

# OpenRouteService (trazado a pie real, gratis): https://openrouteservice.org/dev/#/signup
# Sin clave, la ruta se dibuja en línea recta con tiempos estimados.
ORS_API_KEY=
